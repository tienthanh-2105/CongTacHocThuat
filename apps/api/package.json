{
  "name": "@academic/api",
  "private": true,
  "scripts": {
    "dev": "node --watch --watch-path=src scripts/dev.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "lint": "eslint src test",
    "test": "tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js",
    "test:unit": "tsc -p tsconfig.test.json && node --test dist-test/test/business.unit.test.js",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "db:migrate": "node scripts/database.cjs migrate",
    "db:seed": "node scripts/database.cjs seed",
    "db:check": "node scripts/database.cjs check"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "bcryptjs": "^3.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^16.6.1",
    "mssql": "^12.7.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/mssql": "^12.3.0",
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0"
  }
}
